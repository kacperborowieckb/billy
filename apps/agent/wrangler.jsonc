{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistant-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PERSONAL_AGENT", "class_name": "PersonalAgent" },
      { "name": "MCP_HUB", "class_name": "McpHub" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PersonalAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["McpHub"] },
  ],
  "d1_databases": [
    {
      "binding": "DIRECTORY",
      "database_name": "assistant-directory",
      "migrations_dir": "src/directory/migrations",
      "migrations_pattern": "src/directory/migrations/*/migration.sql",
    },
  ],
  "analytics_engine_datasets": [
    { "binding": "OPERATOR_METRICS", "dataset": "assistant_operator_metrics" },
  ],
  "vars": {
    "TELEGRAM_API_URL": "https://api.telegram.org",
    "AI_GATEWAY_URL": "",
    "AI_GATEWAY_ID": "assistant",
    "MODEL_ROUTES": {
      "primary": {
        "model": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
        "reasoningEffort": "none",
      },
      "secondary": {
        "model": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
        "reasoningEffort": "low",
      },
      "tasks": {
        "reply": "primary",
        "scheduled_task": "primary",
        "proactive": "primary",
        "eval_judge": "secondary",
        "compaction": "primary",
      },
    },
    "MODEL_BILLING": "unified-billing",
    "MCP_TEST_SERVER_URL": "",
    "EDGE_PUBLIC_URL": "",
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "AI_GATEWAY_TOKEN",
      "OPERATOR_TOKEN",
    ],
  },
}
