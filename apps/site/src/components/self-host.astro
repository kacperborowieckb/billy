---
// Self-host: what running Billy yourself means, in three plain facts.
import { buttonVariants } from "@/components/ui/button";

import { icons } from "../art";
import { sourceUrl } from "./nav-links";

const facts = [
  { icon: icons.search, title: "Open source", text: "Read every line on GitHub before you run it." },
  { icon: icons.connector, title: "Your own Cloudflare account", text: "Billy runs where you deploy him, with your own model key." },
  { icon: icons.note, title: "$5 a month", text: "The Cloudflare Workers Paid plan covers one person. You pay your model provider directly." },
];
---

<section id="self-host" class="wrap section selfhost" aria-labelledby="self-host-title">
  <div class="copy">
    <h2 id="self-host-title" class="display-section">Run Billy on your own account.</h2>
    <p class="lede">Billy is open source. Deploy him to your own Cloudflare account, bring your own model key, and keep every byte where you can see it.</p>
    <div class="actions">
      <a class={buttonVariants({ className: "go" })} href={sourceUrl}>Get Billy<svg class="chevron" data-icon="inline-end" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
      <a class={buttonVariants({ variant: "secondary" })} href={sourceUrl}>Read the source</a>
    </div>
  </div>
  <ul class="facts">
    {
      facts.map((fact) => (
        <li>
          <img class="px" src={fact.icon} alt="" width="32" height="32" />
          <h3>{fact.title}</h3>
          <p>{fact.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .selfhost {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: var(--space-8);
  }

  .lede {
    margin-block-start: 18px;
    font-size: 17px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-start: 28px;
  }

  .facts {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-line-strong);
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 4px var(--space-4);
    padding-block: 20px;
    border-block-end: 1px solid var(--color-line-strong);
  }

  img {
    grid-row: span 2;
    inline-size: 40px;
    block-size: 40px;
    padding: 4px;
    border-radius: 12px;
    background: var(--color-surface-raised);
    box-shadow: 0 0 0 1px var(--color-line);
  }

  h3 {
    font: 600 17px / 1.3 var(--font-sans);
  }

  li p {
    color: var(--color-ink-muted);
    font-size: 15px;
  }

  @media (max-width: 1023px) {
    .selfhost {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
