---
// The hero: "Tell Billy." lands, a beat, then "He'll do it all.", one line
// under it and two buttons. Below, a wide stage of Billy's valley: the light
// moves from dawn to day to dusk while Billy works through the day in the
// phone beside him (src/scripts/valley.ts).
import { buttonVariants } from "@/components/ui/button";

import { billy, outfits, world } from "../art";
import Cloud from "./cloud.astro";
import Phone from "./phone.astro";

// Each word waits its place in the line (`--step`) and, on the second line,
// the beat after "Tell Billy." (`--beat`); both are motion tokens.
const words = [
  { text: "Tell", step: 1, beat: 0 },
  { text: "Billy.", step: 2, beat: 0, breakAfter: true },
  { text: "He'll", step: 1, beat: 1 },
  { text: "do", step: 2, beat: 1 },
  { text: "it", step: 3, beat: 1 },
  { text: "all.", step: 4, beat: 1 },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap copy">
    <h1 id="hero-title" class="display-hero headline">
      {
        words.map((word, index) => (
          <>
            <span class="word" style={`--step: ${word.step}; --beat: ${word.beat}`}>
              {word.text}
            </span>
            {word.breakAfter ? <br /> : index < words.length - 1 ? " " : ""}
          </>
        ))
      }
    </h1>
    <p class="lede rise" style="--steps: 0">Whatever you would hand to a great assistant, text it to Billy, and he takes it from there.</p>
    <div class="actions rise" style="--steps: 2">
      <a class={buttonVariants({ className: "go" })} href="#self-host">Get Billy<svg class="chevron" data-icon="inline-end" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
      <a class={buttonVariants({ variant: "secondary" })} href="#keeps">See how it works</a>
    </div>
  </div>

  <div class="wrap">
    <div
      class="stage scene rise"
      style="--steps: 4"
      data-valley
      role="img"
      aria-label="Billy on his dam in the valley, answering messages through the day on a phone beside him. The examples follow."
    >
      <div class="sky sky--dawn is-on" data-sky="dawn"></div>
      <div class="sky sky--day" data-sky="day"></div>
      <div class="sky sky--dusk" data-sky="dusk"></div>
      <img class="px sun" src={world.sun} alt="" width="96" height="96" data-sun />
      <Cloud top="70px" x="18cqw" phase={0.2} />
      <Cloud size="small" top="150px" x="46cqw" phase={0.55} speed={1.6} />
      <Cloud top="40px" x="64cqw" phase={0.8} speed={1.3} />
      <div class="ridge ridge--far"></div>
      <div class="haze"></div>
      <div class="ridge ridge--near"></div>
      <div class="water water-flow"></div>
      <span class="clock"><i></i><span data-clock>08:00</span></span>
      <div class="dam">
        <img class="px log log--left" src={world.log} alt="" width="320" height="88" />
        <img class="px log log--right" src={world.log} alt="" width="320" height="88" />
        <img class="px log log--top" src={world.log} alt="" width="320" height="88" />
        <span class="mascot billy">
          <img class="px" src={billy.base} alt="Billy the Beaver" width="256" height="256" />
          <img class="px" src={outfits.sports} alt="" width="256" height="256" data-outfit />
        </span>
      </div>
      <span class="say is-out" data-say>Morning!</span>
      <Phone class="valley-phone" />
    </div>
    <ul class="visually-hidden">
      <li>At 8:00 Billy sends the morning Brief: the invoice to Marta at 14:00, the dentist at 17:30 and a call to mum at 18:00.</li>
      <li>At midday you ask what Anna wanted for her birthday. Billy finds the Note, a green notebook and a ceramics class, and sets a Reminder for 7 June.</li>
      <li>In the evening you ask him to book dinner for four on Friday. He asks first, then books 19:30.</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block-start: var(--space-7);
    background: linear-gradient(var(--color-surface), color-mix(in srgb, var(--color-sky) 40%, var(--color-surface)) 60%, var(--color-surface));
    text-align: center;
  }

  .copy {
    display: grid;
    justify-items: center;
  }

  .headline {
    font-size: clamp(46px, min(6.6vw, 9.4vh), 88px);
    line-height: 0.98;
  }

  .copy .lede {
    max-inline-size: 34ch;
    margin-block-start: var(--space-4);
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
  }

  .stage {
    position: relative;
    isolation: isolate;
    block-size: clamp(560px, 78vh, 700px);
    margin-block-start: var(--space-7);
    overflow: hidden;
    border-radius: var(--radius-stage);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 6%, transparent);
    text-align: start;
  }

  .sky {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-sky) ease;
  }

  .sky:global(.is-on) {
    opacity: 1;
  }

  .sky--dawn {
    background: linear-gradient(var(--color-dawn), var(--color-dawn-low) 75%);
  }

  .sky--day {
    background: linear-gradient(var(--color-sky), var(--color-sky-low) 75%);
  }

  .sky--dusk {
    background: linear-gradient(var(--color-dusk), var(--color-dusk-low) 75%);
  }

  .sun {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 1;
  }

  .stage :global(.cloud) {
    z-index: 1;
  }

  .ridge,
  .haze,
  .water {
    position: absolute;
    inset-inline: 0;
    z-index: 2;
  }

  /* The hills artwork tiles without a seam; the far ridge is half size and
     faint, the near one at its own size. */
  .ridge {
    background: url("@repo/mascot/assets/world/hills.svg") repeat-x;
    image-rendering: pixelated;
    filter: var(--scenery-light);
  }

  .ridge--far {
    inset-block-end: 130px;
    block-size: 120px;
    background-position: 30% bottom;
    background-size: auto 120px;
    opacity: 0.4;
  }

  .haze {
    inset-block-end: 60px;
    block-size: 200px;
    background: linear-gradient(transparent, color-mix(in srgb, var(--color-sky-low) 55%, transparent) 70%, transparent);
  }

  .ridge--near {
    inset-block-end: 56px;
    block-size: 240px;
    background-position: 62% bottom;
    background-size: auto 240px;
    z-index: 3;
  }

  .water {
    inset-block-end: 0;
    z-index: 3;
    block-size: 64px;
    background: url("@repo/mascot/assets/world/water.svg") repeat-x left top / auto 100%;
    image-rendering: pixelated;
  }

  .clock {
    position: absolute;
    inset-block-start: 22px;
    inset-inline-start: 24px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 7px 12px 7px 10px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface-raised) 78%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-ink) 8%, transparent);
    color: var(--color-forest-ink);
    font: 500 12px / 1 var(--font-mono);
  }

  .clock i {
    inline-size: 7px;
    block-size: 7px;
    border-radius: var(--radius-round);
    background: var(--color-forest);
  }

  /* The dam: logs and Billy at their own size, his head centred over it. */
  .dam {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: calc(32% - 160px);
    z-index: 4;
    inline-size: 320px;
    block-size: 440px;
  }

  .log {
    position: absolute;
    filter: var(--scenery-light);
  }

  .log--left {
    inset-block-end: 20px;
    inset-inline-start: -140px;
  }

  .log--right {
    inset-block-end: 20px;
    inset-inline-start: 140px;
  }

  .log--top {
    inset-block-end: 100px;
    inset-inline-start: -10px;
  }

  .billy {
    --mascot-size: 256px;
    position: absolute;
    inset-block-end: 175px;
    inset-inline-start: 13px;
  }

  .say {
    position: absolute;
    inset-block-end: 450px;
    inset-inline-start: calc(32% + 60px);
    z-index: 5;
    padding: 8px 13px;
    border-radius: 14px 14px 14px 4px;
    background: var(--color-surface-raised);
    box-shadow:
      0 0 0 1px var(--color-line),
      var(--shadow-float);
    font: 500 14px / 1.2 var(--font-sans);
    white-space: nowrap;
    transform-origin: left bottom;
  }

  .say:global(.is-out) {
    opacity: 0;
    scale: 0.94;
    filter: blur(2px);
  }

  .stage :global(.valley-phone) {
    --pw: 300px;
    position: absolute;
    inset-block-end: -14px;
    inset-inline-end: max(6%, calc(50% - 470px));
    z-index: 6;
    aspect-ratio: auto;
    block-size: calc(100% - 56px);
  }

  .word {
    display: inline-block;
  }

  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(0.18em);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(4px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sun {
      transition: transform var(--duration-sun) var(--easing-move);
    }

    .say {
      transition:
        opacity var(--duration-standard) var(--easing-standard),
        scale var(--duration-standard) var(--easing-standard),
        filter var(--duration-standard) var(--easing-standard);
    }

    .word {
      animation: word-in var(--duration-word) var(--easing-standard) both;
      animation-delay: calc(var(--duration-word-step) * var(--step, 0) + var(--duration-word-beat) * var(--beat, 0));
    }

    .rise {
      animation: rise var(--duration-enter) var(--easing-standard) both;
      /* After the second line has landed: the beat, one word's entrance,
         then a step apart. */
      animation-delay: calc(var(--duration-word-beat) + var(--duration-enter) + var(--duration-word-step) * var(--steps, 0));
    }
  }

  /* Narrow screens: a shorter stage, Billy at half size on the left, a
     smaller phone on the right. */
  @media (max-width: 760px) {
    .hero {
      padding-block-start: var(--space-6);
    }

    .stage {
      block-size: 520px;
      border-radius: var(--radius-scene);
    }

    .dam {
      inset-inline-start: 24px;
      scale: 0.5;
      transform-origin: left bottom;
    }

    .say {
      inset-block-end: 236px;
      inset-inline-start: 20px;
    }

    .clock {
      inset-block-start: 14px;
      inset-inline-start: 14px;
    }

    .stage :global(.valley-phone) {
      --pw: 200px;
      inset-block-end: -12px;
      inset-inline-end: 12px;
      block-size: 400px;
    }

    .stage :global(.valley-phone .chat-thread) {
      padding: var(--space-2);
      font-size: 12px;
    }
  }

  /* The narrowest screens: the greeting sits under the clock, clear of the
     phone. */
  @media (max-width: 420px) {
    .say {
      inset-block: 52px auto;
      inset-inline-start: 14px;
    }
  }
</style>
