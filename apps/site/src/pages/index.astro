---
import Explorer from "../components/explorer.astro";
import Faq from "../components/faq.astro";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import Hero from "../components/hero.astro";
import Keeps from "../components/keeps.astro";
import SelfHost from "../components/self-host.astro";
import Base from "../layouts/base.astro";
---

<Base
  title="Billy — a personal agent you text"
  description="Notes, reminders, and follow-ups in one chat. Billy remembers what you tell him, starts the conversation when he can help, and does the work."
>
  <Header />
  <main id="main">
    <Hero />
    <Keeps />
    <Explorer />
    <SelfHost />
    <Faq />
  </main>
  <Footer />
</Base>
